# Copy to .env.local for local development. On Vercel/Netlify, set these in the
# project's Environment Variables page instead (see docs/DEPLOY.md).

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" key (older projects: the "anon" key — NEXT_PUBLIC_SUPABASE_ANON_KEY also works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The "secret" key (older projects: "service_role" — SUPABASE_SERVICE_ROLE_KEY also works).
# Server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
